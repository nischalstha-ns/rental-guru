# ============================================================
# Rental Management System - Environment Configuration
# ============================================================
# Copy this file to assets/.env and fill in your Supabase project details.
# NEVER commit the filled-in .env file to version control.
#
# SECURITY NOTE:
# - The publishable/anon key is SAFE to include in the mobile app.
# - NEVER include SUPABASE_SERVICE_ROLE_KEY in the mobile app.
# - NEVER include database passwords or private API secrets.
# - All sensitive operations must run through Supabase Edge Functions.
# ============================================================

# Primary key format (modern Supabase projects)
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_or_publishable_key_here

# Legacy key format (if your project uses this)
# SUPABASE_ANON_KEY=your_supabase_anon_key_here